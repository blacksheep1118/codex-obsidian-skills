{
  "schema_version": 1,
  "python": {
    "minimum": "3.9",
    "primary": "3.11",
    "validated": ["3.9", "3.11", "3.12"]
  },
  "modules": {
    "pytest": {
      "import_name": "pytest",
      "distribution": "pytest",
      "minimum": "8.0.0",
      "maximum_exclusive": "9.0.0"
    },
    "PyYAML": {
      "import_name": "yaml",
      "distribution": "PyYAML",
      "minimum": "6.0"
    },
    "ruff": {
      "import_name": "ruff",
      "distribution": "ruff",
      "minimum": "0.8.0",
      "maximum_exclusive": "1.0"
    }
  },
  "commands": {
    "git": ["git"],
    "compiler": ["g++", "clang++"],
    "unzip": ["unzip"],
    "bash": ["bash"]
  },
  "profiles": {
    "tool-quick": {
