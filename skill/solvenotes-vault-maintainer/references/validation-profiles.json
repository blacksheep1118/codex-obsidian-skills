      "optional_commands": ["compiler", "unzip", "bash"],
      "requires_notes_root": false,
      "requires_skills_root": true,
      "allows_network": false
    },
    "tool-full": {
      "required_modules": ["pytest", "PyYAML", "ruff"],
      "required_commands": ["git"],
      "optional_commands": ["compiler", "unzip", "bash"],
      "requires_notes_root": false,
      "requires_skills_root": true,
      "allows_network": false
    },
    "vault-quick": {
      "required_modules": ["PyYAML"],
      "required_commands": ["git"],
      "optional_commands": ["compiler", "unzip", "bash"],
      "requires_notes_root": true,
      "requires_skills_root": true,
      "allows_network": false
    },
    "vault-full": {
      "required_modules": ["PyYAML"],
      "required_commands": ["git", "compiler"],
      "optional_commands": ["unzip", "bash"],
      "requires_notes_root": true,
      "requires_skills_root": true,
      "allows_network": false
    },
    "online": {
      "required_modules": ["PyYAML"],
      "required_commands": ["git"],
      "optional_commands": ["unzip", "bash"],
      "requires_notes_root": true,
      "requires_skills_root": true,
      "allows_network": true
    },
    "package-notes": {
      "required_modules": [],
      "required_commands": ["git", "unzip"],
      "optional_commands": [],
      "requires_notes_root": true,
      "requires_skills_root": true,
